def fetch_drop_stages(slug: str) -> dict:
    try:
        r = httpx.get(
            f"{OPENSEA_API_V2_DROPS}/{slug}",
            headers={"X-API-KEY": OPENSEA_API_KEY, "User-Agent": UA},
            timeout=20,
        )
        if r.status_code == 404:
            return {"error": "drop_not_found"}
        if r.status_code == 401:
            return {"error": "api_key_invalid"}
        if r.status_code != 200:
            return {"error": f"http_{r.status_code}"}
        return r.json()
    except Exception as e:
        return {"error": str(e)[:120]}


def fetch_collection_meta(slug: str) -> dict:
