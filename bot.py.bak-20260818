def _parse_proxy_line(line: str) -> str | None:
    """host:port:user:pass → http://user:pass@host:port"""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    if "://" in line:
        return line
    parts = line.split(":")
    if len(parts) == 4:
        host, port, user, pw = parts
        return f"http://{user}:{pw}@{host}:{port}"
    if len(parts) == 2:
        host, port = parts
        return f"http://{host}:{port}"
    return None


def load_proxies() -> list[str]:
    global _PROXIES, _siwe_gate, SIWE_CONCURRENCY
    out: list[str] = []
    if PROXY_FILE.exists():
        for line in PROXY_FILE.read_text().splitlines():
            p = _parse_proxy_line(line)
            if p:
                out.append(p)
    _PROXIES = out
    # With proxies, SIWE can run more concurrent (rate-limit is per-IP).
    # Without proxies, keep serial to avoid 429 storm.
    if out:
        SIWE_CONCURRENCY = min(200, max(4, len(out) * 2))
    else:
        SIWE_CONCURRENCY = 2
    _siwe_gate = threading.Semaphore(SIWE_CONCURRENCY)
    return out


def get_eth_usd() -> float | None:
    """Cached ETH/USD. Coinbase first, CoinGecko fallback. 5 min TTL."""
    now = time.time()
    if _eth_usd_cache["price"] is not None and (now - _eth_usd_cache["at"]) < 300:
        return _eth_usd_cache["price"]
    urls = [
        ("https://api.coinbase.com/v2/prices/ETH-USD/spot", lambda d: float(d["data"]["amount"])),
        (
            "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd",
            lambda d: float(d["ethereum"]["usd"]),
        ),
    ]
    for url, extract in urls:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                data = json.loads(resp.read())
            px = extract(data)
            if px > 0:
                _eth_usd_cache["price"] = px
                _eth_usd_cache["at"] = now
                return px
        except Exception:
            continue
    return _eth_usd_cache["price"]


def next_proxy() -> str | None:
    """Round-robin proxy. None if no proxies loaded."""
    global _proxy_idx
    if not _PROXIES:
        return None
    with _proxy_lock:
        p = _PROXIES[_proxy_idx % len(_PROXIES)]
        _proxy_idx += 1
        return p


# --- proxy screening (added Aug 15 2026) ---
_screen_at = 0.0
_screen_busy = threading.Lock()


def _probe_proxy(proxy: str):
    t0 = time.time()
    try:
        with httpx.Client(proxy=proxy, timeout=PROBE_TIMEOUT, headers={"User-Agent": UA}) as c:
            c.get(SIWE_NONCE_URL)
        return (time.time() - t0, proxy)
    except Exception:
        return (None, proxy)


def screen_proxies(verbose: bool = True) -> int:
    """Latency-probe all proxies in parallel; keep healthy ones, fastest first."""
    global _PROXIES, _screen_at, _proxy_idx
    if not _screen_busy.acquire(blocking=False):
        return -1  # another screen in progress
    try:
        candidates = list(_PROXIES)
        if not candidates:
            return 0
        with ThreadPoolExecutor(max_workers=min(200, len(candidates))) as ex:
            results = list(ex.map(_probe_proxy, candidates))
        healthy = sorted((lat, p) for lat, p in results if lat is not None)
        with _proxy_lock:
            if healthy:
                _PROXIES = [p for _, p in healthy]
                _proxy_idx = 0
            _screen_at = time.time()
        if verbose:
            lats = [lat for lat, _ in healthy]
            avg = sum(lats) / len(lats) if lats else 0.0
            print(f"Proxy screen: {len(healthy)}/{len(candidates)} healthy | avg {avg*1000:.0f}ms", flush=True)
        return len(healthy)
    finally:
        _screen_busy.release()


def maybe_refresh_screen():
    """Background re-screen when stale (never blocks a check)."""
    if _PROXIES and time.time() - _screen_at > SCREEN_TTL:
        threading.Thread(target=screen_proxies, daemon=True).start()


# --- SIWE session cache: skip re-login on repeat checks within TTL ---
_session_cache: dict = {}
_session_cache_lock = threading.Lock()


def _cache_session(address: str, client: httpx.Client):
    try:
        cookies = {c.name: c.value for c in client.cookies.jar}
    except Exception:
        return
    if "access_token" not in str(cookies):
        return
    with _session_cache_lock:
        _session_cache[address.lower()] = {"cookies": cookies, "ts": time.time()}


def _evict_session(address: str):
    with _session_cache_lock:
        _session_cache.pop(address.lower(), None)


def _reuse_session(address: str, proxy: str | None) -> httpx.Client | None:
    with _session_cache_lock:
        ent = _session_cache.get(address.lower())
        if not ent or time.time() - ent["ts"] > SESSION_TTL:
            return None
        cookies = dict(ent["cookies"])
    kwargs = {"timeout": SIWE_TIMEOUT, "follow_redirects": True, "headers": {"User-Agent": UA}}
    if proxy:
        kwargs["proxy"] = proxy
    c = httpx.Client(**kwargs)
    for k, v in cookies.items():
        try:
            c.cookies.set(k, v, domain="opensea.io")
        except Exception:
            pass
    return c


# --- hedged check: race up to 2 lanes (different proxies) per wallet ---
_lane_pool: ThreadPoolExecutor | None = None


def _get_lane_pool() -> ThreadPoolExecutor:
    global _lane_pool
    if _lane_pool is None:
        _lane_pool = ThreadPoolExecutor(max_workers=240, thread_name_prefix="lane")
    return _lane_pool


def raced_check(w: dict, slug: str, api_stages: list) -> dict:
    """Run check_one_wallet; if the first lane is slow, race a second lane on
    another proxy. First clean result wins. Hard cap LANE_TIMEOUT per wallet."""
    pool = _get_lane_pool()
    t0 = time.time()
    lanes = [pool.submit(check_one_wallet, w, slug, api_stages)]
    hedged = False
    last_err = None
    while True:
        remaining = LANE_TIMEOUT - (time.time() - t0)
        if remaining <= 0:
            return {"name": w.get("name", "?"), "error": last_err or "lane timeout",
                    "eligible_labels": [], "public_labels": [], "public_only": False, "wallet": w}
        slice_t = remaining if hedged else min(HEDGE_DELAY, remaining)
        done, _ = wait(lanes, timeout=slice_t, return_when=FIRST_COMPLETED)
        for fut in done:
            lanes.remove(fut)
            try:
                res = fut.result()
            except Exception as e:
                res = {"name": w.get("name", "?"), "error": str(e)[:80], "wallet": w}
            if isinstance(res, dict) and not res.get("error"):
                return res
            last_err = res.get("error") if isinstance(res, dict) else str(res)
        if lanes:
            if not hedged and (time.time() - t0) >= HEDGE_DELAY:
                lanes.append(pool.submit(check_one_wallet, w, slug, api_stages))
                hedged = True
            continue
        # all lanes failed — one fresh lane if budget allows
        if not hedged and (time.time() - t0) < LANE_TIMEOUT - 3.0:
            lanes.append(pool.submit(check_one_wallet, w, slug, api_stages))
            hedged = True
            continue
        return {"name": w.get("name", "?"), "error": last_err or "all lanes failed",
                "eligible_labels": [], "public_labels": [], "public_only": False, "wallet": w}


def load_aw_wallets() -> list[dict]:
    """Load aw1-aw100 + main/vault/burner/vault_2/drain (PK required)."""
    rows = []
    with open(WALLETS_FILE) as f:
        next(f, None)
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(",")
            if len(parts) < 3:
                continue
            name, addr, pk = parts[0].strip(), parts[1].strip(), parts[2].strip()
            key = name.lower()
            if not pk or not pk.startswith("0x") or len(pk) != 66:
                continue
            if not addr.startswith("0x") or len(addr) != 42:
                continue
            m = re.fullmatch(r"aw(\d+)", key)
            if m:
                n = int(m.group(1))
                if n < 1 or n > 100:
                    continue
                rows.append({"name": key, "address": addr, "pk": pk, "n": 100 + n})
                continue
            if key in SPECIAL_ORDER:
                rows.append({"name": key, "address": addr, "pk": pk, "n": SPECIAL_ORDER[key]})
    rows.sort(key=lambda x: x["n"])
    return rows


def parse_slug(text: str) -> str | None:
    """OpenSea slug only (legacy helper)."""
    link = parse_link(text)
    if link and link["source"] == "opensea":
        return link["slug"]
    return None


def parse_link(text: str) -> dict | None:
    """Parse OpenSea or Scatter collection link.
    Returns {source: 'opensea'|'scatter', slug: str} or None.
    """
    text = (text or "").strip()
    if not text:
        return None
    raw = text.split("?")[0].split("#")[0].strip().rstrip("/")
    m = re.search(r"scatter\.art/c/([A-Za-z0-9_-]+)", raw, re.I)
    if m:
        return {"source": "scatter", "slug": m.group(1)}
    m = re.search(r"opensea\.io/(?:collection|drops)/([A-Za-z0-9_-]+)", raw, re.I)
    if m:
        return {"source": "opensea", "slug": m.group(1)}
    # bare slug → default OpenSea (existing behaviour)
    if re.fullmatch(r"[A-Za-z0-9_-]{2,80}", raw) and " " not in raw and not raw.startswith("/"):
        return {"source": "opensea", "slug": raw}
    return None


def tg_api(method: str, payload: dict | None = None) -> dict:
    token = load_token()
    url = f"https://api.telegram.org/bot{token}/{method}"
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if payload is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="ignore")[:300]
        return {"ok": False, "error": f"HTTP {e.code}: {body}"}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def tg_send(chat_id, text, reply_to=None):
    """Send message(s). Returns first message_id (or None)."""
    # Telegram 4096 cap — split if needed
    chunks = []
    while text:
        if len(text) <= 4000:
            chunks.append(text)
            break
        cut = text.rfind("\n", 0, 4000)
        if cut < 1000:
            cut = 4000
        chunks.append(text[:cut])
        text = text[cut:].lstrip("\n")
    first_mid = None
    for i, chunk in enumerate(chunks):
        payload = {"chat_id": chat_id, "text": chunk, "disable_web_page_preview": True}
        if reply_to and i == 0:
            payload["reply_to_message_id"] = reply_to
        res = tg_api("sendMessage", payload)
        if i == 0 and isinstance(res, dict) and res.get("ok"):
            try:
                first_mid = res["result"]["message_id"]
            except Exception:
                first_mid = None
    return first_mid


def tg_edit(chat_id, message_id, text) -> bool:
    """Edit existing message. Truncate hard to 4096. Returns ok bool."""
    if not message_id:
        return False
    if len(text) > 4000:
        text = text[:3990] + "\n…"
    res = tg_api("editMessageText", {
        "chat_id": chat_id,
        "message_id": message_id,
        "text": text,
        "disable_web_page_preview": True,
    })
    if isinstance(res, dict) and res.get("ok"):
        return True
    # ignore "message is not modified"
    err = str((res or {}).get("error") or "")
    if "not modified" in err.lower():
        return True
    return False


def as_dict(x) -> dict:
    return x if isinstance(x, dict) else {}


def as_stage_list(stages) -> list[dict]:
    if not isinstance(stages, list):
        return []
    return [s for s in stages if isinstance(s, dict)]


